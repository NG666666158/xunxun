# Copy this file to project/.env. Never commit the real key.
SILICONFLOW_API_KEY=sk-your-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# OpenAI-compatible chat, embedding and rerank model identifiers.
LLM_MODEL=Qwen/Qwen3-8B
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Vector store: "embedded" (default, one SQLite file under data/, no Docker)
# or "milvus" (needs docker compose + pip install -r requirements-milvus.txt).
VECTOR_BACKEND=embedded
# SQLite file defaults to data/knowledge.sqlite3; override with an absolute EMBEDDED_DB_PATH.

# Milvus Standalone started by docker compose (only used when VECTOR_BACKEND=milvus).
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=root:Milvus

# The Gradio UI and mock business tool share this backend address.
API_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
CONTEXT_TOKEN_BUDGET=9000
MAX_RETRIEVAL_ATTEMPTS=2
MAX_UPLOAD_MB=20

# Optional Langfuse tracing.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
