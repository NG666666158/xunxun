{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window (native pickers, SiliconFlow console links) and the quick-search window (events only).",
  "windows": ["main", "quick"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://cloud.siliconflow.cn/*" }, { "url": "https://docs.siliconflow.cn/*" }]
    }
  ]
}
